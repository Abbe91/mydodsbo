# Copy to .env.local and fill in real values before setting SITE_LAUNCHED=true.
# The prebuild script (scripts/check-todos.mjs) will fail the build if lib/company.ts
# still contains placeholder values AND SITE_LAUNCHED=true.

# Controls noindex, robots.txt, sitemap, and TODO check strictness.
# "false" = development/staging mode (warns on violations, noindex everywhere)
# "true"  = production mode (fails build on violations, normal SEO)
SITE_LAUNCHED=false
